{
  "$defs": {
    "ClientMessage": {
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "First message after pairing: a name the owner will recognise in the device list.",
          "properties": {
            "device_name": {
              "type": "string"
            },
            "type": {
              "const": "hello",
              "type": "string"
            }
          },
          "required": [
            "type",
            "device_name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Starts a job. With `text` the job runs immediately; otherwise audio chunks follow (16 kHz mono PCM16 LE).",
          "properties": {
            "context": {
              "$ref": "#/$defs/WireContext",
              "default": {
                "app": "",
                "title": "",
                "url": null
              }
            },
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "mode": {
              "$ref": "#/$defs/WireMode"
            },
            "text": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "transform",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "pcm16": {
              "type": "string"
            },
            "type": {
              "const": "audio_chunk",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "pcm16"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "audio_end",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "cancel",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "list_profiles",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "ping",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "ErrorCode": {
      "enum": [
        "bad_message",
        "busy",
        "too_large",
        "unknown_job",
        "unauthorized"
      ],
      "type": "string"
    },
    "ProfileInfo": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "ServerMessage": {
      "oneOf": [
        {
          "properties": {
            "device_id": {
              "type": "string"
            },
            "type": {
              "const": "paired",
              "type": "string"
            }
          },
          "required": [
            "type",
            "device_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "device_id": {
              "type": "string"
            },
            "type": {
              "const": "ready",
              "type": "string"
            }
          },
          "required": [
            "type",
            "device_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "stage": {
              "type": "string"
            },
            "type": {
              "const": "stage",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "stage"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "transcript",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "token",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "profile": {
              "type": "string"
            },
            "structure": {
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            },
            "type": {
              "const": "done",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "text",
            "truncated",
            "profile"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "no_speech",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "cancelled",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "reason": {
              "type": "string"
            },
            "type": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "message": {
              "type": "string"
            },
            "type": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "type",
            "code",
            "message"
          ],
          "type": "object"
        },
        {
          "properties": {
            "profiles": {
              "items": {
                "$ref": "#/$defs/ProfileInfo"
              },
              "type": "array"
            },
            "type": {
              "const": "profiles",
              "type": "string"
            }
          },
          "required": [
            "type",
            "profiles"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "pong",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "WireContext": {
      "additionalProperties": false,
      "description": "Where the result will go on the client, declared by the client.",
      "properties": {
        "app": {
          "default": "",
          "type": "string"
        },
        "title": {
          "default": "",
          "type": "string"
        },
        "url": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "WireMode": {
      "enum": [
        "prompt",
        "dictation"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Messages exchanged inside the end-to-end encrypted Noise channel, one JSON object per frame.",
  "limits": {
    "audio_sample_rate": 16000,
    "max_audio_chunk_bytes": 32768,
    "max_audio_seconds": 120,
    "max_message_bytes": 65519,
    "max_text_chars": 8000
  },
  "properties": {
    "client": {
      "$ref": "#/$defs/ClientMessage"
    },
    "server": {
      "$ref": "#/$defs/ServerMessage"
    }
  },
  "protocol_version": 1,
  "title": "Promptify remote protocol"
}
